# Server-side Supabase Edge Function secrets. Never bundle this file in Flutter.
MIDTRANS_SERVER_KEY=your-midtrans-server-key

# Required. The exact value must be sandbox or production and must match the
# Server Key. Missing values, aliases, and conflicting legacy flags are rejected.
MIDTRANS_ENVIRONMENT=sandbox

# Test-only. Exact "true" exposes the canonical QR image URL returned to the
# sandbox QRIS Simulator helper. Keep this unset in production.
# MIDTRANS_ENABLE_SIMULATOR_HELPERS=true

# Deprecated: do not set MIDTRANS_IS_PRODUCTION. If an old deployment still
# carries it during migration, only exact true/false matching the environment is
# accepted; remove it after updating MIDTRANS_ENVIRONMENT.

# Snap is restricted to Other QRIS by server code; no provider-mode secret is
# accepted. MIDTRANS_CLIENT_KEY is intentionally absent from this server-secret
# file: put that public key in Flutter/web runtime config for the Snap.js overlay.
# Android/iOS use the direct redirect WebView and do not require it.
